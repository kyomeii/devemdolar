---
import { WALLETS } from '../config.mjs';

interface Props {
	copyLabel: string;
	copiedLabel: string;
	emptyLabel: string;
}
const { copyLabel, copiedLabel, emptyLabel } = Astro.props;
const wallets = WALLETS.filter((w) => w.address.trim() !== '');
---

{
	wallets.length === 0 ? (
		<p class="wallets-empty not-content">{emptyLabel}</p>
	) : (
		<ul class="wallets not-content">
			{wallets.map((w) => (
				<li class="wallet">
					<div class="wallet-head">
						<strong>{w.coin}</strong>
						<span class="wallet-net">{w.network}</span>
					</div>
					<div class="wallet-row">
						<code class="wallet-addr">{w.address}</code>
						<button type="button" class="wallet-copy" data-address={w.address} data-copied={copiedLabel}>
							{copyLabel}
						</button>
					</div>
				</li>
			))}
		</ul>
	)
}

<script>
	document.querySelectorAll<HTMLButtonElement>('.wallet-copy').forEach((btn) => {
		const original = btn.textContent;
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.address ?? '');
				btn.textContent = btn.dataset.copied ?? 'OK';
				setTimeout(() => (btn.textContent = original), 1800);
			} catch {
				/* clipboard blocked: the address is still selectable */
			}
		});
	});
</script>

<style>
	.wallets {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0;
		display: grid;
		gap: 0.75rem;
	}
	.wallet {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		background: var(--sl-color-black);
	}
	.wallet-head {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}
	.wallet-net {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.wallet-row {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	.wallet-addr {
		flex: 1;
		min-width: 0;
		overflow-wrap: anywhere;
		font-size: var(--sl-text-sm);
		padding: 0.4rem 0.6rem;
		border-radius: 0.4rem;
		background: var(--sl-color-gray-6);
		user-select: all;
	}
	.wallet-copy {
		flex-shrink: 0;
		cursor: pointer;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: none;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.wallets-empty {
		padding: 1rem 1.25rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 0.75rem;
		color: var(--sl-color-gray-3);
		margin: 1.5rem 0;
	}
</style>
