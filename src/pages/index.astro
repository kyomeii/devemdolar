---
// Página raiz: manda o visitante pro idioma do navegador (pt, es ou en).
// Sem JavaScript, cai no português depois de 1 segundo.
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dev em Dólar</title>
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" hreflang="pt-BR" href="/pt/" />
		<link rel="alternate" hreflang="es" href="/es/" />
		<link rel="alternate" hreflang="en" href="/en/" />
		<link rel="alternate" hreflang="x-default" href="/pt/" />
		<meta http-equiv="refresh" content="1; url=/pt/" />
		<script is:inline>
			(function () {
				var langs = navigator.languages || [navigator.language || 'pt'];
				var target = 'pt';
				for (var i = 0; i < langs.length; i++) {
					var l = String(langs[i]).toLowerCase();
					if (l.indexOf('pt') === 0) { target = 'pt'; break; }
					if (l.indexOf('es') === 0) { target = 'es'; break; }
					if (l.indexOf('en') === 0) { target = 'en'; break; }
				}
				location.replace('/' + target + '/');
			})();
		</script>
		<style>
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0a1611; color: #c6f432; font-family: system-ui, sans-serif; }
			a { color: inherit; margin: 0 0.5rem; }
		</style>
	</head>
	<body>
		<p><a href="/pt/">Português</a> · <a href="/es/">Español</a> · <a href="/en/">English</a></p>
	</body>
</html>
